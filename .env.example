# ============================================================
# SisterCare environment configuration
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# See docs/DEVELOPER_GUIDE.md §3 for where to obtain each key.
# ============================================================

# --- Firebase (client SDK — safe to expose, enforced by Firestore rules) ---
# Get these values from your Firebase Console: https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Optional: Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# --- Firebase Admin (SERVER ONLY — this is a secret) ---
# Service account JSON as a single-line string. Required in production:
# without it, protected API routes fail closed with 401/503 responses.
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Supabase migration (will replace Firebase above at cutover) ---
# Project Settings -> API. The service-role key is SERVER ONLY.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local development escape hatch. Never enable in preview or production.
ALLOW_UNAUTHENTICATED_DEV=false

# --- AI (SERVER ONLY) ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# GroqCloud fast inference provider. Free-plan usage is subject to Groq's
# organization-level request and token rate limits.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ordered provider failover. Supported values: groq,gemini
AGENT_PROVIDER_ORDER=groq,gemini

# Sunbird AI (Ugandan language translation, STT, TTS): https://sunbird.ai/
SUNBIRD_API_KEY=

# --- Operations ---
# Shared secret for scheduled jobs calling /api/counsellors/sync-availability
# (sent as the x-cron-secret header)
CRON_SECRET=

# One-time secret for granting the FIRST admin role via POST /api/admin/roles
# (sent as the x-admin-bootstrap-secret header). Rotate/unset after use.
ADMIN_BOOTSTRAP_SECRET=

# Random 32+ character secret used to pseudonymize identifiers in telemetry.
TELEMETRY_HASH_SALT=

# --- Clinical launch approval (SERVER ONLY) ---
# Required when NODE_ENV=production. This is an array containing one named,
# current approval for every content id in src/lib/clinicalGovernance.ts.
# Never enter a fictional reviewer: obtain real clinical/safeguarding sign-off.
# See docs/CLINICAL_GOVERNANCE.md for the required format and release process.
CLINICAL_APPROVALS_JSON=
