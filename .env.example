# SisterCare environment configuration
# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase
# Project Settings -> API Keys. The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Public support contacts used by the counsellor operations portal.
NEXT_PUBLIC_SUPPORT_PHONE=+256704057370
NEXT_PUBLIC_SUPPORT_WHATSAPP=+256704057370
NEXT_PUBLIC_SUPPORT_EMAIL=support@sistercare.app
# Preferred modern server key (sb_secret_...). Never expose it to the browser.
SUPABASE_SECRET_KEY=
# Optional legacy fallback only (JWT whose role claim is service_role).
SUPABASE_SERVICE_ROLE_KEY=

# Local development escape hatch. Never enable in preview or production.
ALLOW_UNAUTHENTICATED_DEV=false

# AI providers (server-only)
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
AGENT_PROVIDER_ORDER=groq,gemini

# Recommended for production Luganda translation, speech-to-text, and
# text-to-speech. Server-only: never create NEXT_PUBLIC_SUNBIRD_API_KEY.
# Create a token at https://api.sunbird.ai/
SUNBIRD_API_KEY=

# Operations
CRON_SECRET=
ADMIN_BOOTSTRAP_SECRET=
TELEMETRY_HASH_SALT=

# Daily private in-app audio (server-only)
# Developers -> API keys. DAILY_DOMAIN is your exact <name>.daily.co host.
DAILY_API_KEY=
DAILY_DOMAIN=

# Clinical launch approval (server-only)
# See docs/CLINICAL_GOVERNANCE.md for the required release process.
CLINICAL_APPROVALS_JSON=
