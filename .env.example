# ============================================================
# SisterCare environment configuration
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# See docs/DEVELOPER_GUIDE.md §3 for where to obtain each key.
# ============================================================

# --- Firebase (client SDK — safe to expose, enforced by Firestore rules) ---
# Get these values from your Firebase Console: https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Optional: Analytics
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id

# --- Firebase Admin (SERVER ONLY — this is a secret) ---
# Service account JSON as a single-line string. Required in production:
# without it, API routes cannot verify ID tokens and run UNAUTHENTICATED.
# Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- AI (SERVER ONLY) ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Sunbird AI (Ugandan language translation, STT, TTS): https://sunbird.ai/
SUNBIRD_API_KEY=

# --- Stellar trust layer (SERVER ONLY) ---
# Leave STELLAR_ISSUER_SECRET_KEY empty to run in dry-run mode (no submission).
STELLAR_NETWORK=testnet
STELLAR_ISSUER_PUBLIC_KEY=
STELLAR_ISSUER_SECRET_KEY=
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Optional: override the network passphrase (defaults follow STELLAR_NETWORK)
STELLAR_NETWORK_PASSPHRASE=

# --- Operations ---
# Shared secret for scheduled jobs calling /api/counsellors/sync-availability
# (sent as the x-cron-secret header)
CRON_SECRET=
