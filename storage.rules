rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Professional profile photos are not identity documents. They are used
    // after KYC approval in the counsellor directory; private credentials
    // remain external/admin-only document references.
    match /counsellor-profile/{uid}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if request.auth != null;
    }
  }
}
