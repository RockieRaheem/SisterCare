rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Subcollections under users (symptoms, etc.)
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Conversations - users can access their own conversations
    match /conversations/{conversationId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow read, update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
    
    // Messages within conversations - check conversation ownership
    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    
    // Reminders - users can access their own reminders
    match /reminders/{reminderId} {
      allow read, write: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
    }
    
    // Symptom logs - users can access their own logs
    match /symptomLogs/{logId} {
      allow read, write: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
    }
    
    // Cycle history - users can access their own history
    match /cycleHistory/{historyId} {
      allow read, write: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid);
      allow create: if request.auth != null && 
        request.resource.data.userId == request.auth.uid;
    }
    
    // Counsellors collection - authenticated users can read
    match /counsellors/{counsellorId} {
      allow read: if request.auth != null;
      allow write: if false; // Admin only via Firebase Console
    }

    // Counselling sessions — lifecycle transitions happen ONLY through the
    // API (Admin SDK). Clients get read access as participants so the portal
    // and room can live-update via onSnapshot.
    match /sessions/{sessionId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || resource.data.counsellorId == request.auth.uid);
      allow write: if false;

      // Room messages flow client-side in real time, participants only,
      // while the session is active. Messages are immutable.
      match /messages/{messageId} {
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid
              || get(/databases/$(database)/documents/sessions/$(sessionId)).data.counsellorId == request.auth.uid);
        allow create: if request.auth != null
          && request.resource.data.senderId == request.auth.uid
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.state == "active"
          && (get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid
              || get(/databases/$(database)/documents/sessions/$(sessionId)).data.counsellorId == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // Counsellor presence — written only via the heartbeat API (Admin SDK);
    // readable by signed-in users (session UI shows availability).
    match /presence/{counsellorId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Event log and reputation ledger — server-only, append-only via Admin SDK.
    match /events/{eventId} {
      allow read, write: if false;
    }
    match /reputation_events/{eventId} {
      allow read, write: if false;
    }

    // Public library content is server-published only. Drafts and KYC review
    // metadata remain inaccessible to clients.
    match /libraryArticles/{articleId} {
      allow read: if resource.data.status == "published";
      allow write: if false;
    }
    match /metrics_daily/{metricId} {
      allow read, write: if false;
    }
    match /incidents/{incidentId} {
      allow read, write: if false;
    }
  }
}
