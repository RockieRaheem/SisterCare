{
  "name": "sistercare",
  "version": "1.0.0",
  "description": "Private, non-judgmental menstrual and emotional support for girls and women",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:safety": "vitest run src/lib/__tests__/safety.test.ts src/lib/__tests__/safetyEvaluation.test.ts src/lib/__tests__/clinicalGovernance.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@daily-co/daily-js": "^0.91.0",
    "@supabase/supabase-js": "^2.111.0",
    "@tailwindcss/forms": "^0.5.11",
    "core-js": "3.37.1",
    "jspdf": "^4.2.1",
    "next": "^16.3.0",
    "node-fetch": "^3.3.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "25.2.0",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.24",
    "eslint": "9.39.2",
    "eslint-config-next": "^16.3.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.19",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
}
